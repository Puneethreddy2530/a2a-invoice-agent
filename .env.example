# AI understanding (AI Pipe example)
LLM_BASE_URL=https://aipipe.org/openrouter/v1
LLM_API_KEY=replace-with-your-private-token
LLM_MODEL=openai/gpt-4.1-nano

# State: choose ONE. DATABASE_URL is recommended for public cloud.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# DATABASE_PATH=./data/invoices.sqlite3

# Optional policy override. Leave blank when the invoice package carries the rule.
AUTO_APPROVAL_LIMIT=

# Optional real/sandbox payment adapter; leave blank for local simulated receipts.
# PAYMENT_EXECUTOR_URL=
# PAYMENT_EXECUTOR_TOKEN=

# Optional API token validation. If unset, endpoints require a non-empty Bearer token.
# A2A_API_TOKEN=generate-a-long-random-secret
# Set after deployment to the public HTTPS origin without a trailing slash.
PUBLIC_BASE_URL=https://your-service.example.com